# Which backend answers the AI requests:
#   claude-code (default) -> the Claude Code installed on this machine, using
#                            its login (`claude auth login`). No API key needed.
#   api                   -> the Claude API, billed to ANTHROPIC_API_KEY.
AI_PROVIDER=claude-code

# Optional, claude-code provider: model to use (empty = Claude Code's default).
# CLAUDE_CODE_MODEL=claude-opus-5-5

# Only for AI_PROVIDER=api. Server-side only; never expose it to the browser.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
